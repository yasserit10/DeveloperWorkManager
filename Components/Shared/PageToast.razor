@implements IAsyncDisposable
@rendermode InteractiveServer

@if (isVisible && !string.IsNullOrWhiteSpace(Message))
{
    <div class="page-toast @(IsError ? "error" : "success") @(isLeaving ? "leaving" : string.Empty)" role="status" aria-live="polite">
        <span class="page-toast-icon"><i class="fa-solid @(IsError ? "fa-circle-exclamation" : "fa-circle-check")" aria-hidden="true"></i></span>
        <span class="min-w-0 flex-1">@Message</span>
        <button type="button" class="page-toast-close" @onclick="Dismiss" aria-label="إغلاق التنبيه"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsError { get; set; }

    private CancellationTokenSource? cancellation;
    private string? lastMessage;
    private bool isVisible;
    private bool isLeaving;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Message))
        {
            lastMessage = null;
            isVisible = false;
            isLeaving = false;
            cancellation?.Cancel();
            return;
        }

        if (Message == lastMessage) return;
        lastMessage = Message;
        isVisible = true;
        isLeaving = false;
        cancellation?.Cancel();
        cancellation?.Dispose();
        cancellation = new CancellationTokenSource();
        _ = DismissAfterDelayAsync(cancellation.Token);
    }

    private async Task DismissAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(2700), cancellationToken);
            isLeaving = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(TimeSpan.FromMilliseconds(300), cancellationToken);
            isVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private void Dismiss()
    {
        cancellation?.Cancel();
        isVisible = false;
    }

    public ValueTask DisposeAsync()
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
}
