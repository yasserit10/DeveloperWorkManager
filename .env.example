# Keep the actual connection string only in the server environment, never in this file.
# Example for a SQL Server instance on the same VPS:
ConnectionStrings__DefaultConnection=Server=localhost;Database=DeveloperWorkManager;User Id=devworkmanager_app;Password=replace-with-a-secret;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# One-time super administrator bootstrap. Remove the password value after the account exists.
BootstrapSuperAdmin__UserName=
BootstrapSuperAdmin__Password=
BootstrapSuperAdmin__FullName=مدير النظام
Identity__AllowSimplePasswords=false
